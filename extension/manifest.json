{
  "manifest_version": 3,
  "name": "Add2Calendar · HKUST(GZ)",
  "version": "0.2.0",
  "description": "Bring enrolled HKUST(GZ) events to Outlook, Google Calendar, Nextcloud, or an iCalendar file.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Add2Calendar settings" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://pdc.hkust-gz.edu.cn/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
