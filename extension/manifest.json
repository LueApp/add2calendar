{
  "manifest_version": 3,
  "name": "Add2Calendar · HKUST(GZ)",
  "version": "0.3.1",
  "description": "Bring HKUST(GZ) PDC events and SIS class schedules to Outlook, Google Calendar, Nextcloud, or iCalendar.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Add2Calendar settings" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://pdc.hkust-gz.edu.cn/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://sisn.hkust-gz.edu.cn/*"],
    "js": ["sis-bridge.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://sisn.hkust-gz.edu.cn/*"],
    "js": ["sis-content.js"],
    "css": ["sis-content.css"],
    "run_at": "document_start"
  }]
}
